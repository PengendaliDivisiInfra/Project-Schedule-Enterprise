# ═══════════════════════════════════════════════════════════════
# ProManage Enterprise - Environment Variables
# ═══════════════════════════════════════════════════════════════

# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_KEY

# ─── Application ───
NEXT_PUBLIC_APP_NAME="ProManage Enterprise"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_COMPANY_NAME="PT Konstruksi Nusantara"

# ─── Compliance ───
NEXT_PUBLIC_REGULATION_PRIMARY="Permen PUPR No.1/2022"
NEXT_PUBLIC_REGULATION_AHSP="SE DJBK No.68/2024"

# ─── Feature Flags ───
NEXT_PUBLIC_ENABLE_REALTIME="true"
NEXT_PUBLIC_ENABLE_LOOKAHEAD="true"
NEXT_PUBLIC_ENABLE_HSD_SYNC="true"

# ─── Vercel (set in dashboard, not here) ───
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=